{
  "name": "arcanus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "images": "node scripts/images.mjs",
    "build": "npm run images && next build && node scripts/postbuild.mjs",
    "preview": "npx --yes serve out -l 3001",
    "lint": "eslint && stylelint \"src/**/*.css\"",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5"
  }
}
